    margin-bottom: 3px !important;
    padding: 4px 8px !important;
  }

  .a4-print-sheet [id="header-instructions"] > div,
  .a4-print-sheet #header-instructions > div {
    margin-top: 3px !important;
    margin-bottom: 3px !important;
    padding: 4px 8px !important;
  }

  .a4-print-sheet [id="header-grading-table"] > div,
  .a4-print-sheet #header-grading-table > div {
    margin-top: 2px !important;
    margin-bottom: 3px !important;
