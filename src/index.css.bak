  }

  .a4-print-sheet .question-mcq-options .katex-display,
  .a4-print-sheet .question-mcq-options .katex,
  .a4-print-sheet .question-mcq-options .katex-html {
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    overflow: visible !important;
  }

  .a4-print-sheet .question-tf-options {
    padding-top: 2px !important;
    margin-top: 2px !important;
    margin-bottom: 2px !important;
    line-height: 1.2 !important;
  }

  .a4-print-sheet .question-matching-container {
    padding-top: 2px !important;
    padding-bottom: 2px !important;
    margin-top: 1px !important;
    margin-bottom: 2px !important;
  }

  .a4-print-sheet .question-matching-container table td,
  .a4-print-sheet .question-matching-container table th {
    padding: 2px 4px !important;
    line-height: 1.2 !important;
    height: auto !important;
  }

  .a4-print-sheet .question-ordering-container {
    padding-top: 2px !important;
    padding-bottom: 2px !important;
    margin-top: 1px !important;
    margin-bottom: 2px !important;
    line-height: 1.2 !important;
  }

  .a4-print-sheet .question-ordering-container > div {
    margin-bottom: 2px !important;
  }

  .a4-print-sheet [id*="section-"][id*="-header"],
  .a4-print-sheet .exam-section-header {
    margin-top: 4px !important;
    margin-bottom: 3px !important;
    padding-top: 2px !important;
