@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap');
@import "tailwindcss";

@theme {
  --color-primary-50: var(--primary-50-hex, var(--color-blue-50));
  --color-primary-100: var(--primary-100-hex, var(--color-blue-100));
  --color-primary-200: var(--primary-200-hex, var(--color-blue-200));
  --color-primary-300: var(--primary-300-hex, var(--color-blue-300));
  --color-primary-400: var(--primary-400-hex, var(--color-blue-400));
  --color-primary-500: var(--primary-500-hex, var(--color-blue-500));
  --color-primary-600: var(--primary-hex, #0f6cbd);
  --color-primary-700: var(--primary-700-hex, #115ea3);
  --color-primary-800: var(--primary-800-hex, var(--color-blue-800));
  --color-primary-900: var(--primary-900-hex, var(--color-blue-900));
  --color-primary-950: var(--primary-950-hex, var(--color-blue-950));

  --color-surface-app: var(--app-bg, #fafaf9);
  --color-surface-card: var(--surface-card, #ffffff);
  --color-surface-subtle: var(--surface-card-subtle, #f5f5f4);
  --color-surface-header: var(--header-bg, #ffffff);
  --color-surface-sidebar: var(--sidebar-bg, #fcfbf9);
  --color-border-theme: var(--border-default, #e2dfdb);
  --color-border-subtle: var(--border-subtle, #f0eeec);

  --color-ai-50: var(--color-violet-50);
  --color-ai-100: var(--color-violet-100);
  --color-ai-200: var(--color-violet-200);
  --color-ai-500: var(--color-violet-500);
  --color-ai-600: var(--color-violet-600);
  --color-ai-700: var(--color-violet-700);
  --color-ai-800: var(--color-violet-800);
  --color-ai-900: var(--color-violet-900);

  --color-success-50: var(--color-emerald-50);
  --color-success-100: var(--color-emerald-100);
  --color-success-200: var(--color-emerald-200);
  --color-success-500: var(--color-emerald-500);
  --color-success-600: var(--color-emerald-600);
  --color-success-800: var(--color-emerald-800);
  --color-success-900: var(--color-emerald-900);

  --color-warning-50: var(--color-orange-50);
  --color-warning-100: var(--color-orange-100);
  --color-warning-200: var(--color-orange-200);
  --color-warning-500: var(--color-orange-500);
  --color-warning-600: var(--color-orange-600);
  --color-warning-800: var(--color-orange-800);
  --color-warning-900: var(--color-orange-900);

  --color-danger-50: var(--color-rose-50);
  --color-danger-100: var(--color-rose-100);
  --color-danger-200: var(--color-rose-200);
  --color-danger-500: var(--color-rose-500);
  --color-danger-600: var(--color-rose-600);
  --color-danger-800: var(--color-rose-800);
  --color-danger-900: var(--color-rose-900);
}

@plugin "@tailwindcss/typography";
@variant dark (&:where(.dark, .dark *));

/* =========================================================================
   CENTRAL DESIGN TOKENS & THEME ENGINE VARIABLES
   ========================================================================= */

/* Default Root & Light Theme: Clean Warm White */
:root,
html.theme-light {
  --app-bg: #fafaf9;
  --surface-card: #ffffff;
  --surface-card-subtle: #f5f5f4;
  --surface-card-hover: #f8f8f7;
  --header-bg: #ffffff;
  --header-border: #e7e5e4;
  --sidebar-bg: #fcfbf9;
  --sidebar-border: #e7e5e4;
  --sidebar-item-hover: #f3f2f1;
  --border-subtle: #f0eeec;
  --border-default: #e2dfdb;
  --border-strong: #cbd5e1;
  --text-main: #1c1917;
  --text-secondary: #44403c;
  --text-muted: #78716c;
  --primary-hex: #2563eb;
  --primary-700-hex: #1d4ed8;
  --primary-50-hex: #eff6ff;
  --primary-100-hex: #dbeafe;
  --primary-200-hex: #bfdbfe;
  --primary-subtle-bg: #eff6ff;
  --primary-subtle-text: #1e40af;
  --primary-subtle-border: #bfdbfe;
  --focus-ring: rgba(37, 99, 235, 0.25);
  --scrollbar-thumb: #d6d3d1;
  --scrollbar-thumb-hover: #a8a29e;
}

/* 1. Theme Emerald: White + Soft Mint Tint + Emerald Accent */
html.theme-emerald {
  --app-bg: #f4faf7;
  --surface-card: #ffffff;
  --surface-card-subtle: #eef7f3;
  --surface-card-hover: #f2f9f5;
  --header-bg: #ffffff;
  --header-border: #d8ebe2;
  --sidebar-bg: #f5fbf8;
  --sidebar-border: #dbece3;
  --sidebar-item-hover: #eaf5f0;
  --border-subtle: #e1efe8;
  --border-default: #cfe5dc;
  --border-strong: #a7d6c3;
  --text-main: #0f291e;
  --text-secondary: #2d5545;
  --text-muted: #527d6d;
  --primary-hex: #059669;
  --primary-700-hex: #047857;
  --primary-50-hex: #ecfdf5;
  --primary-100-hex: #d1fae5;
  --primary-200-hex: #a7f3d0;
  --primary-subtle-bg: #ecfdf5;
  --primary-subtle-text: #065f46;
  --primary-subtle-border: #a7f3d0;
  --focus-ring: rgba(5, 150, 105, 0.25);
  --scrollbar-thumb: #a7d6c3;
  --scrollbar-thumb-hover: #059669;
}

/* 2. Theme Classic Blue: White + Soft Ice Blue Tint + Office Blue Accent */
html.theme-classic-blue {
  --app-bg: #f4f8fc;
  --surface-card: #ffffff;
  --surface-card-subtle: #edf4fa;
  --surface-card-hover: #f0f6fb;
  --header-bg: #ffffff;
  --header-border: #dbe7f4;
  --sidebar-bg: #f5f9fd;
  --sidebar-border: #dbe7f4;
  --sidebar-item-hover: #e8f1fb;
  --border-subtle: #e2ecf7;
  --border-default: #d0e1f2;
  --border-strong: #abc8e8;
  --text-main: #0f1d2e;
  --text-secondary: #2d4765;
  --text-muted: #506e90;
  --primary-hex: #0f6cbd;
  --primary-700-hex: #115ea3;
  --primary-50-hex: #eff6ff;
  --primary-100-hex: #dbeafe;
  --primary-200-hex: #bfdbfe;
  --primary-subtle-bg: #eff6ff;
  --primary-subtle-text: #1e40af;
  --primary-subtle-border: #bfdbfe;
  --focus-ring: rgba(15, 108, 189, 0.25);
  --scrollbar-thumb: #abc8e8;
  --scrollbar-thumb-hover: #0f6cbd;
}

/* 3. Theme Warm Professional: Warm White + Light Ivory Tint + Calm Teal/Slate Accent */
html.theme-warm {
  --app-bg: #faf8f4;
  --surface-card: #ffffff;
  --surface-card-subtle: #f5f1e8;
  --surface-card-hover: #f8f4ec;
  --header-bg: #ffffff;
  --header-border: #ece5d8;
  --sidebar-bg: #fbf9f4;
  --sidebar-border: #ece5d8;
  --sidebar-item-hover: #f3eee4;
  --border-subtle: #f0eae0;
  --border-default: #e4dcd0;
  --border-strong: #cdbfad;
  --text-main: #27221d;
  --text-secondary: #534a40;
  --text-muted: #7c7163;
  --primary-hex: #0d9488;
  --primary-700-hex: #0f766e;
  --primary-50-hex: #f0fdfa;
  --primary-100-hex: #ccfbf1;
  --primary-200-hex: #99f6e4;
  --primary-subtle-bg: #f0fdfa;
  --primary-subtle-text: #115e59;
  --primary-subtle-border: #99f6e4;
  --focus-ring: rgba(13, 148, 136, 0.25);
  --scrollbar-thumb: #cdbfad;
  --scrollbar-thumb-hover: #0d9488;
}

/* 4. Theme Dark / Professional Deep Navy: True Charcoal Navy + Rich Dark Surfaces */
html.dark,
html.theme-dark {
  --app-bg: #0b1120;
  --surface-card: #131d31;
  --surface-card-subtle: #1a263f;
  --surface-card-hover: #1e2c48;
  --header-bg: #0e1626;
  --header-border: #1e2c48;
  --sidebar-bg: #0d1524;
  --sidebar-border: #1e2c48;
  --sidebar-item-hover: #18233a;
  --border-subtle: #1a263f;
  --border-default: #243350;
  --border-strong: #33466b;
  --text-main: #f8fafc;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
  --primary-hex: #38bdf8;
  --primary-700-hex: #0ea5e9;
  --primary-50-hex: #111d33;
  --primary-100-hex: #162a4d;
  --primary-200-hex: #1d3b6e;
  --primary-subtle-bg: #12233f;
  --primary-subtle-text: #38bdf8;
  --primary-subtle-border: #1e3a66;
  --focus-ring: rgba(56, 189, 248, 0.25);
  --scrollbar-thumb: #243350;
  --scrollbar-thumb-hover: #38bdf8;
}

/* Dark mode accents for specific theme classes when in dark mode */
html.dark.theme-emerald {
  --primary-hex: #34d399;
  --primary-700-hex: #10b981;
  --primary-subtle-bg: #062d22;
  --primary-subtle-text: #6ee7b7;
  --primary-subtle-border: #0f5942;
  --focus-ring: rgba(52, 211, 153, 0.25);
}

html.dark.theme-warm {
  --primary-hex: #2dd4bf;
  --primary-700-hex: #14b8a6;
  --primary-subtle-bg: #082f2c;
  --primary-subtle-text: #5eead4;
  --primary-subtle-border: #115e59;
  --focus-ring: rgba(45, 212, 191, 0.25);
}

html.dark.theme-classic-blue {
  --primary-hex: #60a5fa;
  --primary-700-hex: #3b82f6;
  --primary-subtle-bg: #0f2b4c;
  --primary-subtle-text: #93c5fd;
  --primary-subtle-border: #1e3a66;
  --focus-ring: rgba(96, 165, 250, 0.25);
}

/* Global Body and Layout Application */
body {
  background-color: var(--app-bg);
  color: var(--text-main);
  transition: background-color 0.2s ease, color 0.2s ease;
}

.app-header {
  background-color: var(--header-bg) !important;
  border-bottom: 1px solid var(--header-border) !important;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.app-sidebar {
  background-color: var(--sidebar-bg) !important;
  border-left: 1px solid var(--sidebar-border) !important;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.theme-card {
  background-color: var(--surface-card);
  border: 1px solid var(--border-default);
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.theme-card-subtle {
  background-color: var(--surface-card-subtle);
  border: 1px solid var(--border-subtle);
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover);
}

/* Force Left-To-Right direction on all math rendering elements to prevent Arabic RTL layout flipping */

.katex,
.katex *,
.katex-display,
.katex-display *,
.katex-html,
.katex-html *,
[dir="ltr"] .katex,
[dir="ltr"] .katex * {
  direction: ltr !important;
  text-align: left !important;
}

.katex {
  direction: ltr !important;
  unicode-bidi: isolate !important;
  display: inline-block !important;
  white-space: nowrap !important;
  vertical-align: middle;
}

.katex .katex-mathml {
  display: none !important;
}

.katex-display {
  display: block !important;
  text-align: center !important;
  margin: 0.5em 0 !important;
  direction: ltr !important;
  unicode-bidi: isolate !important;
}

/* TipTap Editor Styles */
.ProseMirror {
  outline: none;
  font-size: 12pt;
  font-family: 'Times New Roman', Times, serif;
}
.ProseMirror p {
  margin-top: 0;
  margin-bottom: 0.4em;
  font-size: 12pt;
  line-height: 1.5;
}

/* Paragraph spacing overrides across editors, previews, and print sheets */
.prose p,
.prose-sm p,
.math-text-container p,
.a4-print-sheet p {
  margin-top: 0 !important;
}

.prose p:not([style*="margin-bottom"]),
.prose-sm p:not([style*="margin-bottom"]),
.ProseMirror p:not([style*="margin-bottom"]),
.math-text-container p:not([style*="margin-bottom"]) {
  margin-bottom: 0.4em;
}

p[style*="margin-bottom: 0pt"],
p[style*="margin-bottom: 0px"],
p[data-paragraph-spacing="0pt"],
div[data-paragraph-spacing="0pt"],
*[style*="margin-bottom: 0pt"],
*[style*="margin-bottom: 0px"] {
  margin-top: 0 !important;
  margin-bottom: 0pt !important;
}

p[style*="margin-bottom: 2pt"],
p[data-paragraph-spacing="2pt"],
*[style*="margin-bottom: 2pt"] {
  margin-top: 0 !important;
  margin-bottom: 2pt !important;
}
.ProseMirror table, .prose table, .math-text-container table {
  border-collapse: separate; border-spacing: 0;
  table-layout: fixed;
  width: 100%;
  margin: 0;
  overflow: hidden;
}
.ProseMirror table td,
.ProseMirror table th, .prose table th, .math-text-container table th {
  min-width: 1em;
  border: 1px solid #cbd5e1;
  padding: 3px 5px;
  vertical-align: top;
  box-sizing: border-box;
  position: relative;
}
.dark .ProseMirror table td,
.dark .ProseMirror table th, .prose table th, .math-text-container table th {
  border-color: #334155;
}
.ProseMirror table th, .prose table th, .math-text-container table th {
  font-weight: bold;
  text-align: left;
  background-color: #f1f5f9;
}
.dark .ProseMirror table th, .prose table th, .math-text-container table th {
  background-color: #1e293b;
}
.ProseMirror table .column-resize-handle {
  position: absolute;
  right: -2px;
  top: 0;
  bottom: -2px;
  width: 4px;
  background-color: #3b82f6;
  pointer-events: none;
}
.ProseMirror img, .prose img, .math-text-container img {
  max-width: 100%;
  height: auto;
  border-radius: 0.5rem;
}

/* Ensure any element marked with dir="ltr" is strictly rendered LTR without affecting surrounding RTL text */
[dir="ltr"],
.ProseMirror [dir="ltr"],
.math-text-container [dir="ltr"] {
  direction: ltr !important;
  unicode-bidi: isolate !important;
}


/* ==========================================================================
   Centralized List & Numbering Engine (RTL / LTR BiDi Compliant)
   ========================================================================== */

/* Custom Counter Style for Arabic Abjad (أ، ب، ج، د...) */
@counter-style arabic-abjad {
  system: alphabetic;
  symbols: 'أ' 'ب' 'ج' 'د' 'هـ' 'و' 'ز' 'ح' 'ط' 'ي' 'ك' 'ل' 'م' 'ن' 'س' 'ع' 'ف' 'ص' 'ق' 'ر' 'ش' 'ت' 'ث' 'خ' 'ذ' 'ض' 'ظ' 'غ';
  suffix: ' ';
}

/* 1. Base List Containers */
.prose ul, .ProseMirror ul, .math-text-container ul, .a4-print-sheet ul,
.prose ol, .ProseMirror ol, .math-text-container ol, .a4-print-sheet ol {
  margin-top: 0.25rem !important;
  margin-bottom: 0.5rem !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 0 !important;
  list-style: none !important;
  list-style-type: none !important;
  list-style-position: outside !important;
  box-sizing: border-box !important;
}

/* RTL List Container (Default / Arabic) */
.prose ul:not([dir="ltr"]), .ProseMirror ul:not([dir="ltr"]), .math-text-container ul:not([dir="ltr"]), .a4-print-sheet ul:not([dir="ltr"]),
.prose ol:not([dir="ltr"]), .ProseMirror ol:not([dir="ltr"]), .math-text-container ol:not([dir="ltr"]), .a4-print-sheet ol:not([dir="ltr"]),
[dir="rtl"] ul, [dir="rtl"] ol, ul[dir="rtl"], ol[dir="rtl"] {
  direction: rtl !important;
  text-align: right !important;
  unicode-bidi: isolate !important;
}

/* LTR List Container (English / Math) */
.prose ul[dir="ltr"], .ProseMirror ul[dir="ltr"], .math-text-container ul[dir="ltr"], .a4-print-sheet ul[dir="ltr"],
.prose ol[dir="ltr"], .ProseMirror ol[dir="ltr"], .math-text-container ol[dir="ltr"], .a4-print-sheet ol[dir="ltr"],
[dir="ltr"] ul:not([dir="rtl"]), [dir="ltr"] ol:not([dir="rtl"]) {
  direction: ltr !important;
  text-align: left !important;
  unicode-bidi: isolate !important;
}

/* 2. Base List Items (Self-contained Indentation & Alignment per Item) */
.prose li, .ProseMirror li, .math-text-container li, .a4-print-sheet li {
  position: relative !important;
  line-height: 1.6 !important;
  min-height: 1.5em !important;
  margin-top: 0.15rem !important;
  margin-bottom: 0.15rem !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  list-style: none !important;
  list-style-type: none !important;
  unicode-bidi: isolate !important;
  box-sizing: border-box !important;
}

/* RTL List Items (Padding on the RIGHT, Marker at right: 0) */
.prose li:not([dir="ltr"]), .ProseMirror li:not([dir="ltr"]), .math-text-container li:not([dir="ltr"]), .a4-print-sheet li:not([dir="ltr"]),
li[dir="rtl"], [dir="rtl"] li:not([dir="ltr"]), ul:not([dir="ltr"]) > li:not([dir="ltr"]), ol:not([dir="ltr"]) > li:not([dir="ltr"]) {
  direction: rtl !important;
  text-align: right !important;
  padding-right: 2rem !important;
  padding-left: 0 !important;
}

/* LTR List Items (Padding on the LEFT, Marker at left: 0) */
.prose li[dir="ltr"], .ProseMirror li[dir="ltr"], .math-text-container li[dir="ltr"], .a4-print-sheet li[dir="ltr"],
li[dir="ltr"], [dir="ltr"] li:not([dir="rtl"]), ul[dir="ltr"] > li:not([dir="rtl"]), ol[dir="ltr"] > li:not([dir="rtl"]) {
  direction: ltr !important;
  text-align: left !important;
  padding-left: 2rem !important;
  padding-right: 0 !important;
}

/* Nested Lists (Sub-levels / Multi-level indentation) */
.prose ul ul, .prose ul ol, .prose ol ul, .prose ol ol,
.ProseMirror ul ul, .ProseMirror ul ol, .ProseMirror ol ul, .ProseMirror ol ol,
.math-text-container ul ul, .math-text-container ul ol, .math-text-container ol ul, .math-text-container ol ol,
.a4-print-sheet ul ul, .a4-print-sheet ul ol, .a4-print-sheet ol ul, .a4-print-sheet ol ol {
  margin-top: 0.15rem !important;
  margin-bottom: 0.15rem !important;
  padding: 0 !important;
}

/* Automatic Indentation for nested lists to prevent overlapping with text */
.prose *:not([dir="ltr"]) > ul, .prose *:not([dir="ltr"]) > ol,
.ProseMirror *:not([dir="ltr"]) > ul, .ProseMirror *:not([dir="ltr"]) > ol,
.math-text-container *:not([dir="ltr"]) > ul, .math-text-container *:not([dir="ltr"]) > ol,
.a4-print-sheet *:not([dir="ltr"]) > ul, .a4-print-sheet *:not([dir="ltr"]) > ol,
ul:not([dir="ltr"]) ul, ul:not([dir="ltr"]) ol, ol:not([dir="ltr"]) ul, ol:not([dir="ltr"]) ol {
  margin-right: 1.5rem !important;
  margin-left: 0 !important;
}

.prose [dir="ltr"] > ul, .prose [dir="ltr"] > ol,
.ProseMirror [dir="ltr"] > ul, .ProseMirror [dir="ltr"] > ol,
.math-text-container [dir="ltr"] > ul, .math-text-container [dir="ltr"] > ol,
.a4-print-sheet [dir="ltr"] > ul, .a4-print-sheet [dir="ltr"] > ol,
ul[dir="ltr"] ul, ul[dir="ltr"] ol, ol[dir="ltr"] ul, ol[dir="ltr"] ol {
  margin-left: 1.5rem !important;
  margin-right: 0 !important;
}

/* Paragraphs & direct block children inside List Item */
.prose li > p, .ProseMirror li > p, .math-text-container li > p, .a4-print-sheet li > p,
.prose li > div, .ProseMirror li > div, .math-text-container li > div, .a4-print-sheet li > div {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
  padding: 0 !important;
  line-height: inherit !important;
  display: block !important;
  unicode-bidi: isolate !important;
}

/* 3. Base Marker Pseudo-Element (Marker placed inside dedicated padding box) */
.prose ul > li::before, .ProseMirror ul > li::before, .math-text-container ul > li::before, .a4-print-sheet ul > li::before,
.prose ol > li::before, .ProseMirror ol > li::before, .math-text-container ol > li::before, .a4-print-sheet ol > li::before {
  position: absolute !important;
  top: 0 !important;
  height: 1.6em !important;
  width: 1.75rem !important;
  font-weight: 600 !important;
  font-variant-numeric: tabular-nums !important;
  color: currentColor !important;
  pointer-events: none !important;
  user-select: none !important;
  line-height: 1.6 !important;
  unicode-bidi: isolate !important;
  box-sizing: border-box !important;
  margin: 0 !important;
}

/* RTL Markers: Bullet / Number at right: 0, immediately right of text on the exact same line */
.prose ul:not([dir="ltr"]) > li:not([dir="ltr"])::before, .ProseMirror ul:not([dir="ltr"]) > li:not([dir="ltr"])::before,
.math-text-container ul:not([dir="ltr"]) > li:not([dir="ltr"])::before, .a4-print-sheet ul:not([dir="ltr"]) > li:not([dir="ltr"])::before,
.prose ol:not([dir="ltr"]) > li:not([dir="ltr"])::before, .ProseMirror ol:not([dir="ltr"]) > li:not([dir="ltr"])::before,
.math-text-container ol:not([dir="ltr"]) > li:not([dir="ltr"])::before, .a4-print-sheet ol:not([dir="ltr"]) > li:not([dir="ltr"])::before,
ul[dir="rtl"] > li::before, ol[dir="rtl"] > li::before,
[dir="rtl"] ul > li::before, [dir="rtl"] ol > li::before,
li[dir="rtl"]::before {
  right: 0 !important;
  left: auto !important;
  direction: rtl !important;
  text-align: right !important;
  display: inline-flex !important;
  justify-content: flex-start !important;
  align-items: flex-start !important;
}

/* LTR Markers: Bullet / Number at left: 0, immediately left of text on the exact same line */
.prose ul[dir="ltr"] > li::before, .ProseMirror ul[dir="ltr"] > li::before,
.math-text-container ul[dir="ltr"] > li::before, .a4-print-sheet ul[dir="ltr"] > li::before,
.prose ol[dir="ltr"] > li::before, .ProseMirror ol[dir="ltr"] > li::before,
.math-text-container ol[dir="ltr"] > li::before, .a4-print-sheet ol[dir="ltr"] > li::before,
[dir="ltr"] ul:not([dir="rtl"]) > li::before, [dir="ltr"] ol:not([dir="rtl"]) > li::before,
li[dir="ltr"]::before {
  left: 0 !important;
  right: auto !important;
  direction: ltr !important;
  text-align: left !important;
  display: inline-flex !important;
  justify-content: flex-start !important;
  align-items: flex-start !important;
}

/* 4. Unordered Bullet Lists - Symbol Mappings */
.prose ul > li::before, .ProseMirror ul > li::before, .math-text-container ul > li::before, .a4-print-sheet ul > li::before {
  content: var(--list-style, "•\00a0") !important;
}

.prose ul[data-list-style="disc"] > li::before, .ProseMirror ul[data-list-style="disc"] > li::before, .math-text-container ul[data-list-style="disc"] > li::before, .a4-print-sheet ul[data-list-style="disc"] > li::before,
.prose ul[data-list-style="•"] > li::before, .ProseMirror ul[data-list-style="•"] > li::before, .math-text-container ul[data-list-style="•"] > li::before, .a4-print-sheet ul[data-list-style="•"] > li::before {
  content: "•\00a0" !important;
}

.prose ul[data-list-style="circle"] > li::before, .ProseMirror ul[data-list-style="circle"] > li::before, .math-text-container ul[data-list-style="circle"] > li::before, .a4-print-sheet ul[data-list-style="circle"] > li::before,
.prose ul[data-list-style="○"] > li::before, .ProseMirror ul[data-list-style="○"] > li::before, .math-text-container ul[data-list-style="○"] > li::before, .a4-print-sheet ul[data-list-style="○"] > li::before {
