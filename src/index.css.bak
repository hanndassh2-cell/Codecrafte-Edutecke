/* Remove large margins and padding from math blocks inside tables */
.prose td .my-2.p-2, .ProseMirror td .my-2.p-2, .math-text-container td .my-2.p-2, .a4-print-sheet td .my-2.p-2 {
  margin-top: 0 !important;
  margin-bottom: 0 !important;
  padding-top: 0.1rem !important;
  padding-bottom: 0.1rem !important;
}

/* Hide raw math source */
.hidden-math-text {
  display: none !important;
}
.math-raw-source {
  display: none !important;
}

/* =========================================================================
   Universal Word Wrapping & Overflow-X Prevention for Editors & Previews
   ========================================================================= */
.ProseMirror {
  outline: none !important;
  max-width: 100% !important;
  width: 100% !important;
  word-break: break-word !important;
  overflow-wrap: break-word !important;
  box-sizing: border-box !important;
}

.ProseMirror p, 
.ProseMirror div, 
.ProseMirror h1, 
.ProseMirror h2, 
.ProseMirror h3, 
.ProseMirror h4, 
.ProseMirror h5, 
.ProseMirror h6, 
.ProseMirror blockquote, 
.ProseMirror ul, 
.ProseMirror ol, 
.ProseMirror li {
  max-width: 100% !important;
  word-break: break-word !important;
  overflow-wrap: break-word !important;
  box-sizing: border-box !important;
}

.math-text-container, 
.math-text-container p, 
.math-text-container div, 
.math-text-container span,
.math-text-container li {
  max-width: 100% !important;
  word-break: break-word !important;
  overflow-wrap: break-word !important;
  box-sizing: border-box !important;
}

/* Scrollable math equation blocks when an equation is wider than container, with vertical clearance */
.katex-display, .math-block-wrapper {
  max-width: 100% !important;
  overflow-x: auto !important;
  overflow-y: visible !important;
  padding-top: 4px !important;
  padding-bottom: 8px !important;
  scrollbar-width: thin;
}

.katex-display > .katex {
  display: inline-block !important;
  padding-top: 2px !important;
  padding-bottom: 6px !important;
  overflow: visible !important;
}

.katex-html {
  overflow: visible !important;
  padding-bottom: 2px !important;
}

/* =========================================================================
   Centralized Question Renderer & Numbering Integrity
   ========================================================================= */
.exam-question-item,
.question-renderer-block {
  unicode-bidi: isolate;
}

/* Question sub-blocks avoid internal breaking while allowing question and answer key to flow naturally */
.question-prompt-container,
.question-options-container,
.question-tf-options,
.question-matching-container,
.question-ordering-container {
  break-inside: avoid !important;
  page-break-inside: avoid !important;
}

@media print {
  .question-prompt-container,
  .question-options-container,
  .question-tf-options,
  .question-matching-container,
  .question-ordering-container {
    break-inside: avoid !important;
    page-break-inside: avoid !important;
  }

  .model-answer-box {
    background-color: #f3e8ff !important;
    color: #3b0764 !important;
    border: 2px solid #c084fc !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
}

/* Ensure the question number and the first line of text align on the same baseline */
.question-prompt-container {
  align-items: baseline !important;
}

.question-number-badge {
  white-space: nowrap !important;
  line-height: inherit !important;
  vertical-align: baseline !important;
}

/* Ensure the first paragraph inside MathText has zero top-margin so it does not drop below the number */
.question-prompt-text > .math-text-container > p:first-child,
.question-prompt-text > .math-text-container > div:first-child,
.question-prompt-text > p:first-child,
.question-prompt-text p:first-of-type {
  margin-top: 0 !important;
  margin-bottom: 0.25rem !important;
  display: inline;
}

/* 
  Fix trailing empty paragraphs/blank blocks taking up unnecessary vertical space 
  Applies to: OCR, AI inserts, paste artifacts, and general rich text editors 
  It hides trailing empty paragraphs, but reveals them if the editor is focused 
  so the user can still type on the new line. 
*/
.ProseMirror:not(:focus-within) > p:last-child:empty:not(:first-child),
.ProseMirror:not(:focus-within) > p:last-child:has(> br:only-child):not(:first-child),
.ProseMirror:not(:focus-within) > p:last-child > br:only-child {
  display: none;
}

/* Ensure empty paragraphs inside preview cards also do not take up space */
.preview-content > p:last-child:empty,
.preview-content > p:last-child:has(> br:only-child) {
  display: none;
}

.question-prompt-text > .math-text-container {
  display: inline;
}

.question-prompt-text > .math-text-container > * {
  display: inline;
}

.question-prompt-text > .math-text-container > .my-2,
.question-prompt-text > .math-text-container > .block {
  display: block;
  margin-top: 0.25rem !important;
}

/* 
  Fix equations globally in preview, print, and PDF:
  Clean, borderless, transparent without blue frames or hover boxes
*/
.a4-print-sheet .math-rendered-block,
.a4-print-sheet .math-rendered-inline,
.a4-preview-container .math-rendered-block,
.a4-preview-container .math-rendered-inline,
.preview-content .math-rendered-block,
.preview-content .math-rendered-inline,
.print-document .math-rendered-block,
.print-document .math-rendered-inline,
.question-renderer-block .math-rendered-block,
.question-renderer-block .math-rendered-inline,
.exam-question-item .math-rendered-block,
.exam-question-item .math-rendered-inline,
[data-preview="true"] .math-rendered-block,
[data-preview="true"] .math-rendered-inline,
.ProseMirror td .math-rendered-block,
.ProseMirror th .math-rendered-block,
.ProseMirror td .math-rendered-inline,
.ProseMirror th .math-rendered-inline,
.preview-content td .math-rendered-block,
.preview-content th .math-rendered-block,
.preview-content td .math-rendered-inline,
.preview-content th .math-rendered-inline,
table td .math-rendered-block,
table th .math-rendered-block,
table td .math-rendered-inline,
table th .math-rendered-inline {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  outline: none !important;
  transform: none !important;
  cursor: default !important;
  margin: 0 !important;
  padding: 0 !important;
}

.a4-print-sheet .math-rendered-block:hover,
.a4-print-sheet .math-rendered-inline:hover,
.a4-preview-container .math-rendered-block:hover,
.a4-preview-container .math-rendered-inline:hover,
.preview-content .math-rendered-block:hover,
.preview-content .math-rendered-inline:hover,
.print-document .math-rendered-block:hover,
.print-document .math-rendered-inline:hover,
.question-renderer-block .math-rendered-block:hover,
.question-renderer-block .math-rendered-inline:hover,
[data-preview="true"] .math-rendered-block:hover,
[data-preview="true"] .math-rendered-inline:hover,
.ProseMirror td .math-rendered-block:hover,
.ProseMirror th .math-rendered-block:hover,
.ProseMirror td .math-rendered-inline:hover,
.ProseMirror th .math-rendered-inline:hover,
table td .math-rendered-block:hover,
table th .math-rendered-block:hover,
table td .math-rendered-inline:hover,
table th .math-rendered-inline:hover {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  transform: none !important;
}

/* Hide edit hints and editor buttons in preview, print, and PDF */
.a4-print-sheet span[class*="group-hover"],
.a4-print-sheet .editor-only-hint,
.a4-preview-container span[class*="group-hover"],
.a4-preview-container .editor-only-hint,
.preview-content span[class*="group-hover"],
.preview-content .editor-only-hint,
.print-document span[class*="group-hover"],
.print-document .editor-only-hint {
  display: none !important;
}

/* MathText block container transparent inside print and preview */
.a4-print-sheet .math-text-container > div,
.a4-preview-container .math-text-container > div,
.preview-content .math-text-container > div,
.print-document .math-text-container > div,
.question-renderer-block .math-text-container > div,
td .math-text-container .my-2.p-2.rounded-lg,
th .math-text-container .my-2.p-2.rounded-lg {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  outline: none !important;
}

/* Eliminate hover outline/border changes on cards in preview/print */
.a4-print-sheet [class*="hover:border"]:hover,
.a4-preview-container [class*="hover:border"]:hover,
.preview-content [class*="hover:border"]:hover,
.print-document [class*="hover:border"]:hover {
  border-color: inherit !important;
}

/* Hide all buttons, inputs, edit controls, and no-print elements in print sheets and PDF exports */
.a4-print-sheet button,
.a4-print-sheet [role="button"],
.a4-print-sheet .no-print,
.a4-print-sheet .no-pdf,
.a4-print-sheet [class*="print:hidden"],
.a4-print-sheet [data-no-print="true"],
.a4-print-sheet .editor-only-hint,
.print-document button,
.print-document [role="button"],
.print-document .no-print,
.print-document .no-pdf,
.print-document [class*="print:hidden"] {
  display: none !important;
}

.ProseMirror td .math-rendered-block > *,
.ProseMirror th .math-rendered-block > *,
.preview-content td .math-rendered-block > *,
.preview-content th .math-rendered-block > *,
table td .math-rendered-block > *,
table th .math-rendered-block > * {
  margin: 0 !important;
  padding: 0 !important;
  display: inline-block !important;
}

/* Ensure the Katex equation fits within the cell and doesn't add extra vertical space */
td .katex-display,
th .katex-display {
  margin: 0 !important;
  padding: 0 !important;
  display: inline-block !important;
}

table td > p, table th > p {
  margin-bottom: 0 !important;
}

/* =========================================================================
   MCQ Options Table & Formula Proportional Auto-Fit Styles
   ========================================================================= */
.question-mcq-options {
  width: 100% !important;
  max-width: 100% !important;
  overflow: visible !important;
  box-sizing: border-box !important;
  scrollbar-width: none !important;
  -ms-overflow-style: none !important;
  margin-top: 1px !important;
  margin-bottom: 2px !important;
  padding-top: 2px !important;
  padding-bottom: 2px !important;
  height: auto !important;
  min-height: 0 !important;
}

.question-mcq-options::-webkit-scrollbar {
  display: none !important;
}

.question-mcq-options table {
  width: 100% !important;
  max-width: 100% !important;
  table-layout: fixed !important;
  border-collapse: separate !important; border-spacing: 0 !important;
  margin: 0 !important;
  height: auto !important;
  min-height: 0 !important;
}

.question-mcq-options tbody,
.question-mcq-options tr {
  height: auto !important;
  min-height: 0 !important;
}

.question-mcq-options td {
  height: auto !important;
  min-height: 0 !important;
  vertical-align: middle !important;
  word-break: break-word !important;
  overflow-wrap: anywhere !important;
  white-space: normal !important;
  box-sizing: border-box !important;
  padding-top: 2.5px !important;
  padding-bottom: 2.5px !important;
  padding-left: 5px !important;
  padding-right: 5px !important;
  line-height: 1.2 !important;
}

.question-mcq-options td > div {
  height: auto !important;
  min-height: 0 !important;
  align-items: center !important;
}

.question-mcq-options .mcq-option-content {
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0 !important;
  word-break: break-word !important;
  overflow-wrap: anywhere !important;
  white-space: normal !important;
  overflow: visible !important;
}

/* Ensure math formulas inside MCQ options scale proportionally within the cell */
.question-mcq-options .katex-display,
.question-mcq-options .math-block-wrapper {
  max-width: 100% !important;
  overflow-x: visible !important;
  overflow-y: visible !important;
  margin: 0 !important;
  padding: 0 !important;
  display: inline-block !important;
  scrollbar-width: none !important;
}

.question-mcq-options .katex {
  max-width: 100% !important;
  font-size: min(1em, 100%) !important;
  vertical-align: middle !important;
}

.question-mcq-options .katex-html {
  max-width: 100% !important;
  overflow: visible !important;
  white-space: normal !important;
}

.question-mcq-options img,
.question-mcq-options svg {
  max-width: 100% !important;
  height: auto !important;
  object-fit: contain !important;
  display: inline-block !important;
}

@media print {
  .question-mcq-options {
    overflow: visible !important;
    width: 100% !important;
    max-width: 100% !important;
    scrollbar-width: none !important;
  }
  .question-mcq-options table {
    width: 100% !important;
    max-width: 100% !important;
    table-layout: fixed !important;
    border-collapse: separate !important; border-spacing: 0 !important;
  }
  .question-mcq-options tr,
  .question-mcq-options td {
    height: auto !important;
    overflow: visible !important;
    word-break: break-word !important;
    overflow-wrap: anywhere !important;
    white-space: normal !important;
  }
  .question-mcq-options .katex-display,
  .question-mcq-options .math-block-wrapper,
  .question-mcq-options .katex {
    max-width: 100% !important;
    overflow-x: visible !important;
    overflow-y: visible !important;
  }
}




/* Math Selection Styles */
.math-selected {
  background-color: rgba(191, 219, 254, 0.7) !important;
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.5) !important;
  border-color: transparent !important;
}
.math-selected .katex {
  color: #1e3a8a !important;
}
.dark .math-selected {
  background-color: rgba(30, 58, 138, 0.7) !important;
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.5) !important;
}
.dark .math-selected .katex {
  color: #bfdbfe !important;
}


/* Override line-height for lists in print sheet */
.a4-print-sheet li, .pdf-print-density li, .a4-print-sheet ul > li::before, .a4-print-sheet ol > li::before, .pdf-print-density ul > li::before, .pdf-print-density ol > li::before {
  line-height: 1.2 !important;
  min-height: 1.2em !important;
  margin-top: 0px !important;
  margin-bottom: 0px !important;
}


/* Override ALL paragraph margins in print sheet to be perfectly compact */
.a4-print-sheet p, .pdf-print-density p {
  margin-bottom: 0px !important;
  margin-top: 0px !important;
  line-height: 1.2 !important;
}


/* Override math block margins in print sheet to be perfectly compact */
.a4-print-sheet .katex-display, .pdf-print-density .katex-display, .a4-print-sheet .math-block-wrapper, .pdf-print-density .math-block-wrapper {
  margin-top: 2px !important;
  margin-bottom: 2px !important;
  padding-top: 0px !important;
  padding-bottom: 0px !important;
}
.a4-print-sheet .katex-display > .katex, .pdf-print-density .katex-display > .katex {
  padding-top: 0px !important;
  padding-bottom: 0px !important;
}


/* Override MathText block wrapper margins in print sheet to be perfectly compact */
.a4-print-sheet .my-2\.5, .pdf-print-density .my-2\.5 {
  margin-top: 2px !important;
  margin-bottom: 2px !important;
  padding-top: 0px !important;
  padding-bottom: 0px !important;
}
.a4-print-sheet .py-3\.5, .pdf-print-density .py-3\.5 {
  padding-top: 0px !important;
  padding-bottom: 0px !important;
}


/* Ensure math blocks have tight margins in print */
.a4-print-sheet .math-rendered-block, .pdf-print-density .math-rendered-block, .a4-print-sheet .math-text-container .my-2\.5, .pdf-print-density .math-text-container .my-2\.5, .a4-print-sheet [class*="math"], .pdf-print-density [class*="math"] {
  margin-top: 2px !important;
  margin-bottom: 2px !important;
  padding-top: 0px !important;
  padding-bottom: 0px !important;
}
.a4-print-sheet .katex-display, .pdf-print-density .katex-display {
  margin-top: 2px !important;
  margin-bottom: 2px !important;
  padding-top: 0px !important;
  padding-bottom: 0px !important;
}
.a4-print-sheet .katex-display > .katex, .pdf-print-density .katex-display > .katex {
  padding-top: 0px !important;
  padding-bottom: 0px !important;
}


/* Ensure empty paragraphs take no space in print sheet */
.a4-print-sheet p:empty, .pdf-print-density p:empty, .a4-print-sheet p:has(> br:only-child), .pdf-print-density p:has(> br:only-child) {
  display: none !important;
  margin: 0 !important;
  padding: 0 !important;
  height: 0 !important;
}


/* Override question item margins in print sheet to be perfectly compact */
.a4-print-sheet .exam-question-item, .pdf-print-density .exam-question-item {
  margin-top: 2px !important;
  margin-bottom: 2px !important;
  padding-top: 0px !important;
  padding-bottom: 0px !important;
}

/* AGGRESSIVE PRINT MATH FIXES */
@media print {
  .math-rendered-block, .katex-display, .math-block-wrapper, .my-2\.5 {
    margin: 0 !important;
    padding: 0 !important;
  }
  .katex-display > .katex {
    padding: 0 !important;
    margin: 0 !important;
  }
  p {
    margin-bottom: 0 !important;
  }
}
.a4-print-sheet .math-rendered-block,
.pdf-print-density .math-rendered-block,
.a4-print-sheet .katex-display,
.pdf-print-density .katex-display,
.a4-print-sheet .math-block-wrapper,
.pdf-print-density .math-block-wrapper,
.a4-print-sheet .my-2\.5,
.pdf-print-density .my-2\.5 {
  margin: 0 !important;
  padding: 0 !important;
}
.a4-print-sheet .katex-display > .katex,
.pdf-print-density .katex-display > .katex {
  margin: 0 !important;
  padding: 0 !important;
}
.a4-print-sheet p,
.pdf-print-density p {
  margin-bottom: 0 !important;
}

/* COMPACT PRINT MATH REFINEMENTS */
@media print {
  /* Reduce spacing between paragraphs inside question text */
  .a4-print-sheet .question-text-node p,
  .a4-print-sheet .question-prompt-text p {
    margin-bottom: 0.35rem !important;
  }

  /* Ensure math blocks are strictly block-level to avoid horizontal stacking, but compact */
  .a4-print-sheet .math-block-wrapper-preview,
  .a4-print-sheet .math-rendered-block {
    display: block !important;
    margin-top: 0.35rem !important;
    margin-bottom: 0.35rem !important;
    padding: 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .a4-print-sheet .katex-display {
    margin: 0.25rem 0 !important;
  }
  
  /* Reset inline katex so they don't break */
  .a4-print-sheet .katex {
    line-height: inherit;
  }
}
