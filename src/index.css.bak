}

.prose ul[data-list-style="square"] > li::before, .ProseMirror ul[data-list-style="square"] > li::before, .math-text-container ul[data-list-style="square"] > li::before, .a4-print-sheet ul[data-list-style="square"] > li::before,
.prose ul[data-list-style="■"] > li::before, .ProseMirror ul[data-list-style="■"] > li::before, .math-text-container ul[data-list-style="■"] > li::before, .a4-print-sheet ul[data-list-style="■"] > li::before {
  content: "■\00a0" !important;
}

.prose ul[data-list-style="white-square"] > li::before, .ProseMirror ul[data-list-style="white-square"] > li::before, .math-text-container ul[data-list-style="white-square"] > li::before, .a4-print-sheet ul[data-list-style="white-square"] > li::before,
.prose ul[data-list-style="□"] > li::before, .ProseMirror ul[data-list-style="□"] > li::before, .math-text-container ul[data-list-style="□"] > li::before, .a4-print-sheet ul[data-list-style="□"] > li::before {
  content: "□\00a0" !important;
}

.prose ul[data-list-style="diamond"] > li::before, .ProseMirror ul[data-list-style="diamond"] > li::before, .math-text-container ul[data-list-style="diamond"] > li::before, .a4-print-sheet ul[data-list-style="diamond"] > li::before,
.prose ul[data-list-style="◆"] > li::before, .ProseMirror ul[data-list-style="◆"] > li::before, .math-text-container ul[data-list-style="◆"] > li::before, .a4-print-sheet ul[data-list-style="◆"] > li::before {
  content: "◆\00a0" !important;
}

.prose ul[data-list-style="white-diamond"] > li::before, .ProseMirror ul[data-list-style="white-diamond"] > li::before, .math-text-container ul[data-list-style="white-diamond"] > li::before, .a4-print-sheet ul[data-list-style="white-diamond"] > li::before,
.prose ul[data-list-style="◇"] > li::before, .ProseMirror ul[data-list-style="◇"] > li::before, .math-text-container ul[data-list-style="◇"] > li::before, .a4-print-sheet ul[data-list-style="◇"] > li::before {
  content: "◇\00a0" !important;
}

.prose ul[data-list-style="star"] > li::before, .ProseMirror ul[data-list-style="star"] > li::before, .math-text-container ul[data-list-style="star"] > li::before, .a4-print-sheet ul[data-list-style="star"] > li::before,
.prose ul[data-list-style="★"] > li::before, .ProseMirror ul[data-list-style="★"] > li::before, .math-text-container ul[data-list-style="★"] > li::before, .a4-print-sheet ul[data-list-style="★"] > li::before {
  content: "★\00a0" !important;
}

.prose ul[data-list-style="white-star"] > li::before, .ProseMirror ul[data-list-style="white-star"] > li::before, .math-text-container ul[data-list-style="white-star"] > li::before, .a4-print-sheet ul[data-list-style="white-star"] > li::before,
.prose ul[data-list-style="☆"] > li::before, .ProseMirror ul[data-list-style="☆"] > li::before, .math-text-container ul[data-list-style="☆"] > li::before, .a4-print-sheet ul[data-list-style="☆"] > li::before {
  content: "☆\00a0" !important;
}

.prose ul[data-list-style="check"] > li::before, .ProseMirror ul[data-list-style="check"] > li::before, .math-text-container ul[data-list-style="check"] > li::before, .a4-print-sheet ul[data-list-style="check"] > li::before,
.prose ul[data-list-style="✓"] > li::before, .ProseMirror ul[data-list-style="✓"] > li::before, .math-text-container ul[data-list-style="✓"] > li::before, .a4-print-sheet ul[data-list-style="✓"] > li::before {
  content: "✓\00a0" !important;
}

.prose ul[data-list-style="heavy-check"] > li::before, .ProseMirror ul[data-list-style="heavy-check"] > li::before, .math-text-container ul[data-list-style="heavy-check"] > li::before, .a4-print-sheet ul[data-list-style="heavy-check"] > li::before,
.prose ul[data-list-style="✔"] > li::before, .ProseMirror ul[data-list-style="✔"] > li::before, .math-text-container ul[data-list-style="✔"] > li::before, .a4-print-sheet ul[data-list-style="✔"] > li::before {
  content: "✔\00a0" !important;
}

.prose ul[data-list-style="arrow"] > li::before, .ProseMirror ul[data-list-style="arrow"] > li::before, .math-text-container ul[data-list-style="arrow"] > li::before, .a4-print-sheet ul[data-list-style="arrow"] > li::before,
.prose ul[data-list-style="➤"] > li::before, .ProseMirror ul[data-list-style="➤"] > li::before, .math-text-container ul[data-list-style="➤"] > li::before, .a4-print-sheet ul[data-list-style="➤"] > li::before {
  content: "➤\00a0" !important;
}

.prose ul[data-list-style="blue-diamond"] > li::before, .ProseMirror ul[data-list-style="blue-diamond"] > li::before, .math-text-container ul[data-list-style="blue-diamond"] > li::before, .a4-print-sheet ul[data-list-style="blue-diamond"] > li::before,
.prose ul[data-list-style="🔹"] > li::before, .ProseMirror ul[data-list-style="🔹"] > li::before, .math-text-container ul[data-list-style="🔹"] > li::before, .a4-print-sheet ul[data-list-style="🔹"] > li::before {
  content: "🔹\00a0" !important;
}

.prose ul[data-list-style="bulb"] > li::before, .ProseMirror ul[data-list-style="bulb"] > li::before, .math-text-container ul[data-list-style="bulb"] > li::before, .a4-print-sheet ul[data-list-style="bulb"] > li::before,
.prose ul[data-list-style="💡"] > li::before, .ProseMirror ul[data-list-style="💡"] > li::before, .math-text-container ul[data-list-style="💡"] > li::before, .a4-print-sheet ul[data-list-style="💡"] > li::before {
  content: "💡\00a0" !important;
}

.prose ul[data-list-style="pin"] > li::before, .ProseMirror ul[data-list-style="pin"] > li::before, .math-text-container ul[data-list-style="pin"] > li::before, .a4-print-sheet ul[data-list-style="pin"] > li::before,
.prose ul[data-list-style="📌"] > li::before, .ProseMirror ul[data-list-style="📌"] > li::before, .math-text-container ul[data-list-style="📌"] > li::before, .a4-print-sheet ul[data-list-style="📌"] > li::before {
  content: "📌\00a0" !important;
}

/* Legacy data-bullet-symbol support */
.prose ul[data-bullet-symbol] > li::before, .ProseMirror ul[data-bullet-symbol] > li::before, .math-text-container ul[data-bullet-symbol] > li::before, .a4-print-sheet ul[data-bullet-symbol] > li::before {
  content: var(--list-style, "•\00a0") !important;
}

/* 5. Ordered Numbered Lists - Counter & Formats */
.prose ol, .ProseMirror ol, .math-text-container ol, .a4-print-sheet ol {
  counter-reset: custom-counter;
}

.prose ol > li, .ProseMirror ol > li, .math-text-container ol > li, .a4-print-sheet ol > li {
  counter-increment: custom-counter;
}

/* Default Decimal (1. 2. 3.) */
.prose ol > li::before, .ProseMirror ol > li::before, .math-text-container ol > li::before, .a4-print-sheet ol > li::before,
.prose ol[data-list-style="decimal"] > li::before, .ProseMirror ol[data-list-style="decimal"] > li::before, .math-text-container ol[data-list-style="decimal"] > li::before, .a4-print-sheet ol[data-list-style="decimal"] > li::before {
  content: counter(custom-counter) ".\00a0" !important;
}

/* Decimal Parenthesis: 1) 2) 3) */
.prose ol[data-list-style="decimal-paren"] > li::before, .ProseMirror ol[data-list-style="decimal-paren"] > li::before, .math-text-container ol[data-list-style="decimal-paren"] > li::before, .a4-print-sheet ol[data-list-style="decimal-paren"] > li::before {
  content: counter(custom-counter) ")\00a0" !important;
}

/* Decimal Dash: 1- 2- 3- */
.prose ol[data-list-style="decimal-dash"] > li::before, .ProseMirror ol[data-list-style="decimal-dash"] > li::before, .math-text-container ol[data-list-style="decimal-dash"] > li::before, .a4-print-sheet ol[data-list-style="decimal-dash"] > li::before {
  content: counter(custom-counter) "-\00a0" !important;
}

/* Arabic Abjad: أ. ب. ج. */
.prose ol[data-list-style="arabic-abjad"] > li::before, .ProseMirror ol[data-list-style="arabic-abjad"] > li::before, .math-text-container ol[data-list-style="arabic-abjad"] > li::before, .a4-print-sheet ol[data-list-style="arabic-abjad"] > li::before {
  content: counter(custom-counter, arabic-abjad) ".\00a0" !important;
}

/* Arabic Abjad Parenthesis: أ) ب) ج) */
.prose ol[data-list-style="arabic-abjad-paren"] > li::before, .ProseMirror ol[data-list-style="arabic-abjad-paren"] > li::before, .math-text-container ol[data-list-style="arabic-abjad-paren"] > li::before, .a4-print-sheet ol[data-list-style="arabic-abjad-paren"] > li::before {
  content: counter(custom-counter, arabic-abjad) ")\00a0" !important;
}

/* Arabic Abjad Dash: أ- ب- ج- */
.prose ol[data-list-style="arabic-abjad-dash"] > li::before, .ProseMirror ol[data-list-style="arabic-abjad-dash"] > li::before, .math-text-container ol[data-list-style="arabic-abjad-dash"] > li::before, .a4-print-sheet ol[data-list-style="arabic-abjad-dash"] > li::before {
  content: counter(custom-counter, arabic-abjad) "-\00a0" !important;
}

/* Uppercase Latin: A. B. C. */
.prose ol[data-list-style="upper-alpha"] > li::before, .ProseMirror ol[data-list-style="upper-alpha"] > li::before, .math-text-container ol[data-list-style="upper-alpha"] > li::before, .a4-print-sheet ol[data-list-style="upper-alpha"] > li::before {
  content: counter(custom-counter, upper-alpha) ".\00a0" !important;
}

/* Lowercase Latin: a. b. c. */
.prose ol[data-list-style="lower-alpha"] > li::before, .ProseMirror ol[data-list-style="lower-alpha"] > li::before, .math-text-container ol[data-list-style="lower-alpha"] > li::before, .a4-print-sheet ol[data-list-style="lower-alpha"] > li::before {
  content: counter(custom-counter, lower-alpha) ".\00a0" !important;
}

/* Uppercase Roman: I. II. III. */
.prose ol[data-list-style="upper-roman"] > li::before, .ProseMirror ol[data-list-style="upper-roman"] > li::before, .math-text-container ol[data-list-style="upper-roman"] > li::before, .a4-print-sheet ol[data-list-style="upper-roman"] > li::before {
  content: counter(custom-counter, upper-roman) ".\00a0" !important;
}

/* Lowercase Roman: i. ii. iii. */
.prose ol[data-list-style="lower-roman"] > li::before, .ProseMirror ol[data-list-style="lower-roman"] > li::before, .math-text-container ol[data-list-style="lower-roman"] > li::before, .a4-print-sheet ol[data-list-style="lower-roman"] > li::before {
  content: counter(custom-counter, lower-roman) ".\00a0" !important;
}

/* Circled Numbers ① ② ③ */
.prose ol[data-list-style="circled"] > li::before, .ProseMirror ol[data-list-style="circled"] > li::before, .math-text-container ol[data-list-style="circled"] > li::before, .a4-print-sheet ol[data-list-style="circled"] > li::before {
  content: counter(custom-counter) !important;
  display: inline-flex !important;
  justify-content: center !important;
  align-items: center !important;
  width: 1.25rem !important;
  height: 1.25rem !important;
  border-radius: 9999px !important;
  border: 1.5px solid currentColor !important;
  font-size: 0.75rem !important;
  font-weight: 700 !important;
  line-height: 1 !important;
  top: 0.15rem !important;
}

/* Filled Circled Numbers ❶ ❷ ❸ */
.prose ol[data-list-style="circled-filled"] > li::before, .ProseMirror ol[data-list-style="circled-filled"] > li::before, .math-text-container ol[data-list-style="circled-filled"] > li::before, .a4-print-sheet ol[data-list-style="circled-filled"] > li::before {
  content: counter(custom-counter) !important;
  display: inline-flex !important;
  justify-content: center !important;
  align-items: center !important;
  width: 1.25rem !important;
  height: 1.25rem !important;
  border-radius: 9999px !important;
  background-color: currentColor !important;
  color: #ffffff !important;
  font-size: 0.75rem !important;
  font-weight: 700 !important;
  line-height: 1 !important;
  top: 0.15rem !important;
}



/* 3. Tables */
.prose table, .ProseMirror table, .math-text-container table {
  margin-top: 0 !important;
  margin-bottom: 8pt !important;
  border-collapse: separate !important; border-spacing: 0 !important;
  table-layout: fixed !important;
  width: 100% !important;
}

.prose td, .prose th, .ProseMirror td, .ProseMirror th, .math-text-container td, .math-text-container th {
  padding: 4px 8px !important;
  border: 1px solid #cbd5e1 !important;
  vertical-align: top !important;
  box-sizing: border-box !important;
  position: relative !important;
  min-width: 1em !important;
}

.dark .prose td, .dark .prose th, .dark .ProseMirror td, .dark .ProseMirror th, .dark .math-text-container td, .dark .math-text-container th {
  border-color: #334155 !important;
}

.prose th, .ProseMirror th, .math-text-container th {
  font-weight: bold !important;
  text-align: right !important;
  background-color: #f1f5f9 !important;
}

[dir="ltr"] .prose th, [dir="ltr"] .ProseMirror th, [dir="ltr"] .math-text-container th {
  text-align: left !important;
}

.dark .prose th, .dark .ProseMirror th, .dark .math-text-container th {
  background-color: #1e293b !important;
}


/* 4. Table Cell Overrides */
.prose td.selectedCell, .prose th.selectedCell, .ProseMirror td.selectedCell, .ProseMirror th.selectedCell {
  background-color: rgba(99, 102, 241, 0.2) !important;
  border-color: rgba(99, 102, 241, 0.5) !important;
}

.prose td p, .prose th p, .ProseMirror td p, .ProseMirror th p, .math-text-container td p, .math-text-container th p, .a4-print-sheet td p, .a4-print-sheet th p {
  margin-bottom: 0 !important;
  margin-top: 0 !important;
}



/* Remove margins from lists and list items inside tables */
.prose td ul, .prose td ol, .ProseMirror td ul, .ProseMirror td ol, .math-text-container td ul, .math-text-container td ol, .a4-print-sheet td ul, .a4-print-sheet td ol {
  margin-bottom: 0 !important;
  margin-top: 0 !important;
}

.prose td li, .ProseMirror td li, .math-text-container td li, .a4-print-sheet td li {
  margin-bottom: 0 !important;
  margin-top: 0 !important;
}

/* Ensure empty paragraphs or breaks don't blow up table rows */
.prose td p:empty, .ProseMirror td p:empty, .math-text-container td p:empty, .a4-print-sheet td p:empty {
  display: none !important;
}

/* Force compact line-height in tables for preview and print */
.prose table, .ProseMirror table, .math-text-container table, .a4-print-sheet table {
  line-height: 1.2 !important;
}

/* Print Overrides to Ensure PDF matches Preview with optimal A4 space utilization */
@media print {
  .a4-print-sheet {
    box-shadow: none !important;
    border: none !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    height: 100% !important;
    line-height: 1.2 !important;
  }

  .a4-print-sheet .exam-question-item,
  .a4-print-sheet .question-renderer-block,
  .a4-print-sheet .question-block {
    margin-top: 1px !important;
    margin-bottom: 2px !important;
    padding-top: 2px !important;
    padding-bottom: 2px !important;
    break-inside: avoid !important;
    page-break-inside: avoid !important;
  }

  .a4-print-sheet .question-header-row,
  .a4-print-sheet .question-prompt-container,
  .a4-print-sheet .question-text-node {
    line-height: 1.2 !important;
  }

  .a4-print-sheet .question-prompt-container p,
  .a4-print-sheet .question-text-node p,
  .a4-print-sheet .math-text-container p,
  .a4-print-sheet .prose p {
    margin-top: 0 !important;
    margin-bottom: 0px !important;
  line-height: 1.2 !important;
  }

  .a4-print-sheet .question-mcq-options {
    padding-top: 2px !important;
    padding-bottom: 2px !important;
    margin-top: 1px !important;
    margin-bottom: 2px !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: visible !important;
  }

  .a4-print-sheet .question-mcq-options table {
    margin-top: 1px !important;
    margin-bottom: 1px !important;
    border-collapse: separate !important; border-spacing: 0 !important;
    table-layout: fixed !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
  }

  .a4-print-sheet .question-mcq-options tbody,
  .a4-print-sheet .question-mcq-options tr {
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
  }

  .a4-print-sheet .question-mcq-options td {
    padding-top: 2.5px !important;
    padding-bottom: 2.5px !important;
